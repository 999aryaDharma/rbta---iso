# RBTA + Isolation Forest — Lenovo / Docker Desktop
# Copy to deploy/local/.env. Never commit the resulting .env file.

RBTA_API_KEY=ganti-dengan-token-demo-lokal-yang-panjang
RBTA_MODEL_VERSION=reference-v1
RBTA_HOST_PORT=8010
RBTA_SOURCE_MODE=DEFERRED
RBTA_LOG_LEVEL=INFO

# Native PowerShell / Docker Desktop path. Use forward slashes to avoid escaping.
RBTA_REPLAY_HOST_DIR=D:/KAMPUS/SKRIPSI/wazuh-data-2026/indexer-export

# Directory containing the version folder, for example models/reference-v1/.
# This relative path is resolved by the launcher from the repository root.
RBTA_MODEL_HOST_DIR=./models

# Lenovo defaults; increase only after observing actual host utilization.
RBTA_CPU_LIMIT=4.00
RBTA_MEMORY_LIMIT=4096M
RBTA_PIDS_LIMIT=200
