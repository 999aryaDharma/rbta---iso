# ==============================================================================
# RBTA + ISOLATION FOREST — ASUS PRODUCTION DEPLOYMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure all mandatory variables before deployment.

# ── Mandatory Security & Research Invariants ─────────────────────────────────
RBTA_API_KEY=replace-with-strong-production-bearer-token
RBTA_MODEL_VERSION=production-model-version
RBTA_SOURCE_MODE=DEFERRED

# ── Network & Port Configuration ─────────────────────────────────────────────
# Explicit host port binding (1024..65535, port 8000 default is disallowed)
RBTA_HOST_PORT=8011

# ── Host Directory Mounts ───────────────────────────────────────────────────
RBTA_STATE_HOST_DIR=/srv/rbta/state
RBTA_MODEL_HOST_DIR=/srv/rbta/models
RBTA_REPLAY_HOST_DIR=/srv/rbta/replay

# ── Build Provenance & Container Image ───────────────────────────────────────
RBTA_CODE_SHA=replace-with-verified-ci-code-sha
RBTA_IMAGE_TAG=sha-latest
RBTA_BUILD_DATE=2026-08-29T12:00:00Z

# ── Operational Logging & Resource Baseline ─────────────────────────────────
RBTA_LOG_LEVEL=INFO
RBTA_CPU_LIMIT=2.00
RBTA_MEMORY_LIMIT=1024M
RBTA_PIDS_LIMIT=100
RBTA_CPU_RESERVATION=0.25
RBTA_MEMORY_RESERVATION=256M
