# ==============================================================================
# RBTA + Isolation Forest Service — Operational Environment Configuration Template
# ==============================================================================
# Copy this template to .env on the deployment server and configure safe values.
# NEVER commit real credentials, production API keys, or private tokens to git.
# ==============================================================================

# REST API Security
# -----------------
# API Key for ingress and administrative endpoints. Leave empty for unauthenticated local development.
RBTA_API_KEY=change-this-to-a-secure-random-token

# Model Artifact Registry
# -----------------------
# Path to host-mounted directory containing versioned model artifact bundles.
RBTA_MODEL_REGISTRY_DIR=artifacts/models

# Explicit model version to activate for online inference.
# Example: deploy-smoke-v1 or v1 (Must correspond to a subfolder in RBTA_MODEL_REGISTRY_DIR)
RBTA_MODEL_VERSION=deploy-smoke-v1

# Durable Runtime State
# ---------------------
# Path to host-mounted JSON state file preserving engine seen IDs, active buckets, and outbox.
RBTA_STATE_FILE=data/runtime/state.json

# Server Network & Logging
# ------------------------
# Host address to bind. Keep 127.0.0.1 for local/loopback isolation behind reverse proxy.
RBTA_HOST=127.0.0.1
RBTA_PORT=8000
RBTA_LOG_LEVEL=INFO

# Wazuh Indexer Live Poller (Optional)
# ------------------------------------
# Configure if running continuous live polling against campus Wazuh Indexer cluster.
# WAZUH_INDEXER_URL=https://127.0.0.1:9200
# WAZUH_INDEXER_USERNAME=wazuh_poller
# WAZUH_INDEXER_PASSWORD=placeholder-password
# WAZUH_INDEXER_VERIFY_TLS=true

# Shuffle SOAR Outbox Forwarder (Optional)
# ----------------------------------------
# Configure if pushing scored meta-alerts automatically to Shuffle SOAR webhook.
# SHUFFLE_WEBHOOK_URL=https://shuffle.internal/api/v1/hooks/webhook_id
# SHUFFLE_API_KEY=placeholder-shuffle-key
