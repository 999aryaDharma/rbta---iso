# ==============================================================================
# RBTA + Isolation Forest Service — Operational Environment Configuration Template
# ==============================================================================
# Copy this template to deploy/asus/.env on the ASUS server and configure values.
# NEVER commit real credentials, production API keys, or private tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY FOR PRODUCTION DEPLOYMENT
# ------------------------------------------------------------------------------

# Production REST API Key (Fail-closed: Container will NOT start if empty)
# Must be a secure high-entropy token for securing /api/v1/* and /runtime/stats.
RBTA_API_KEY=change-this-to-a-secure-random-token

# Explicit Active Model Version (Fail-closed: Container will NOT start if empty)
# Must match a subdirectory name inside the model registry (e.g. deploy/asus/models/<version>).
# NOTE: 'deploy-smoke-v1' is an engineering smoke artifact used for CI and testing, NOT the final seminar model.
RBTA_MODEL_VERSION=deploy-smoke-v1

# ------------------------------------------------------------------------------
# 2. CONFIGURABLE OPERATIONAL PARAMETERS
# ------------------------------------------------------------------------------

# Host Loopback Port (Default: 8000)
RBTA_HOST_PORT=8000

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
RBTA_LOG_LEVEL=INFO

# Resource Limits (Provisional conservative boundaries for ASUS server)
RBTA_CPU_LIMIT=2.00
RBTA_MEMORY_LIMIT=1024M
RBTA_PIDS_LIMIT=100
RBTA_CPU_RESERVATION=0.25
RBTA_MEMORY_RESERVATION=256M

# ------------------------------------------------------------------------------
# 3. DEFERRED UNTIL LIVE WAZUH / SOAR INTEGRATION SESSION
# ------------------------------------------------------------------------------
# Do not configure until actual campus network routes, credentials, and TLS certs are confirmed.

# Wazuh Indexer Cluster Polling (Deferred)
# WAZUH_INDEXER_URL=https://127.0.0.1:9200
# WAZUH_INDEXER_USERNAME=wazuh_poller
# WAZUH_INDEXER_PASSWORD=placeholder-password
# WAZUH_INDEXER_VERIFY_TLS=true
# WAZUH_INDEXER_CA_BUNDLE=/app/certs/root-ca.pem

# Shuffle SOAR Outbox Forwarder (Deferred)
# SHUFFLE_WEBHOOK_URL=https://shuffle.internal/api/v1/hooks/webhook_id
# SHUFFLE_API_KEY=placeholder-shuffle-key
